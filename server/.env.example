# Copy this to .env for local development
# On Railway: set these in the Variables tab (Railway auto-sets DATABASE_URL)

# PostgreSQL connection string
# Local:    postgresql://postgres:password@localhost:5432/hobbyorigin
# Railway:  set automatically — just add the Postgres plugin
# Supabase: copy from Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/hobbyorigin

PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
ALLOWED_ORIGINS=https://app.hobbyorigin.com,https://hobbyorigin.com
